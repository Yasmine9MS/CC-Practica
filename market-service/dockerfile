FROM python:3.13.15-alpine3.24

WORKDIR /app

RUN apk upgrade --no-cache \
    && addgroup -S app \
    && adduser -S app -G app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=app:app . .

USER app

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]